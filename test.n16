N16
VERSION=1

NAME=Sound Test
RESOLUTION=320x240
SCANMODE=p
REFRESH=30
REQUIRED=bmpix,ctrl,sndply
ICON=

[PALETTE]

COLOR=#000000
COLOR=#FFFFFF
COLOR=#808080
COLOR=#C0C0C0
COLOR=#0000FF
COLOR=#FF0000
COLOR=#00AA00
COLOR=#FFFF00

[AUDIO]

NAME=test
MIME=audio/mpeg


[CODE]

function gameStart() {

    bmpix.clear(1);

    bmpix.text(
        "PCTECH NANO",
        100,
        80,
        12,
        0
    );

    bmpix.text(
        "SOUND TEST",
        100,
        105,
        12,
        0
    );

    bmpix.text(
        "ENTER = PLAY",
        90,
        145,
        10,
        0
    );

    bmpix.text(
        "MARK = STOP",
        90,
        165,
        10,
        0
    );
}


function gameFrame() {

    if (
        ctrl.pressed("START")
    ) {

        sndply.play(
            "test"
        );
    }


    if (
        ctrl.pressed("MARK")
    ) {

        sndply.stop(
            "test"
        );
    }
}


window.gameStart =
    gameStart;

window.gameFrame =
    gameFrame;